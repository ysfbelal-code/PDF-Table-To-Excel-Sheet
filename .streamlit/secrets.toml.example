# Streamlit Secrets Configuration Example
# Copy this file to .streamlit/secrets.toml and fill in your actual values
# DO NOT commit secrets.toml to version control (it's in .gitignore)

[smtp]
server = "smtp.gmail.com"
port = 465
username = "your-email@gmail.com"
password = "your-app-specific-password"
sender = "your-email@gmail.com"

# For Gmail:
# 1. Enable 2-Step Verification on your Google Account
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
# 3. Use the 16-character password above (not your account password)
